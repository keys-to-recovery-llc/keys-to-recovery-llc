# Keys to Recovery LLC — environment configuration.
# Copy to .env / Worker vars as appropriate. NEVER commit real secrets.
# The repo is PUBLIC. Production secrets are set with `wrangler secret put`.

# --- Worker (worker/) ---

# Signs session cookies (HMAC). REQUIRED in production.
#   wrangler secret put SESSION_SECRET
SESSION_SECRET=

# Email provider (HTTP API driver). When both are set, the Worker sends
# mail through the provider; when unset, the dev driver logs mail to the
# console and the site runs end-to-end with no external keys.
#   wrangler secret put EMAIL_API_KEY
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=no-reply@keystorecoveryllc.com

# Submission recipient allowlist (comma-separated). Submissions addressed
# outside this list are delivered to the first entry instead — the API
# must never become an open relay.
NOTIFICATION_RECIPIENTS=Support@keystorecoveryllc.com,bart@keystorecoveryllc.com

# Recipient for general contact-form notifications (docs/API-CONTRACT.md §2.4).
CONTACT_RECIPIENT=Support@keystorecoveryllc.com

# Public base URL of the site, used in password set/reset email links.
APP_BASE_URL=https://keystorecoveryllc.com

# Google sign-in (OPTIONAL, owner-gated). Unset = /api/auth/google*
# returns 501 google_auth_not_configured. Do not invent credentials.
#   wrangler secret put GOOGLE_CLIENT_SECRET
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Welcome email for new registrations (OPTIONAL). The welcome-email
# template content must be supplied by the owner first
# (see MIGRATION.md Q7); disabled by default.
WELCOME_EMAIL_ENABLED=false
WELCOME_EMAIL_SUBJECT=
WELCOME_EMAIL_BODY=
